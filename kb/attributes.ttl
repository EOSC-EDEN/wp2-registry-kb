trsp:att.2080C1D4EE
    a skos:Concept ;
    skos:prefLabel "Integrity" ;
    skos:definition "The property that data or digital objects are complete and have not been altered in an unauthorised or unintended manner." .

trsp:att.09B9B96513
    a skos:Concept ;
    skos:prefLabel "File Repair" ;

trsp:att.3532A00A80
    a skos:Concept ;
    skos:prefLabel "Confidentiality and Ethics" ;
    skos:definition "Determine if ethical norms have been adhered to, if consent has been granted by subjects, confidentiality respected, and similar concerns" .

trsp:att.4DE2DD546E

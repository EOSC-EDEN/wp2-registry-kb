@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix trsp: <https://w3id.org/trsp/> .
@prefix edenkb: <https://w3id.org/eosc-eden/kb#> .

trsp:att.4CB9ED25FE
    a skos:Concept ;
    skos:prefLabel "Sustainability" ;
    skos:definition "Sustainability refers to a trustworthy repository's capacity to ensure uninterrupted, long-term access to its data holdings for current and future user communities. It encompasses the repository's ability to maintain and evolve its services over time, typically documented through a formal sustainability plan or dedicated webpage outlining strategies to meet changing user requirements." .

trsp:att.0849A7F1E2
    a skos:Concept ;
    skos:prefLabel "Social Sustainability" ;
    skos:definition "Aspects such as open governance, community involvement and engagement, planning and continuity arrangements, forum and working group participation and creation. Frequent user surveys, publication of roadmaps." .

trsp:att.539A68DF8A
    a skos:Concept ;
    skos:prefLabel "Governance" ;
    skos:definition "The structures, authority, decision processes and accountability arrangements by which an organisation or service is directed and controlled." .

trsp:att.7C68DBB456
    a skos:Concept ;
    skos:prefLabel "Governance Description" ;
    skos:definition "A repository or research-infrastructure characteristic describing governance description in the context of governance." .

trsp:att.247C3C5849
    a skos:Concept ;
    skos:prefLabel "Stakeholder Representation" ;
    skos:definition "A characteristic describing how the repository identifies, represents, supports or engages relevant communities and stakeholders." .

trsp:att.494B22C440
    a skos:Concept ;
    skos:prefLabel "Governance Model" ;
    skos:definition "Type of governance and management model" .

trsp:att.4E4FD79526
    a skos:Concept ;
    skos:prefLabel "Expert Guidance" ;
    skos:definition "Use of appropriate subject, technical, legal or preservation expertise to guide repository policy, practice and review." .

trsp:att.1FC6BCD089
    a skos:Concept ;
    skos:prefLabel "Periodic Expert/ External Review" ;
    skos:definition "A repository or research-infrastructure characteristic describing periodic expert/ external review in the context of expert guidance." .

trsp:att.6237ED1101
    a skos:Concept ;
    skos:prefLabel "Living Will" ;
    skos:definition "A documented plan specifying how stewardship responsibilities, holdings and associated information will be handled if a repository can no longer operate." .

trsp:att.42D7C2C3A4
    a skos:Concept ;
    skos:prefLabel "Public Statement of Wind-Down" ;
    skos:definition "A repository or research-infrastructure characteristic describing public statement of wind-down in the context of living will." .

trsp:att.5FBAF6DC9F
    a skos:Concept ;
    skos:prefLabel "Planning/ Continuity" ;
    skos:definition "Planning for sustained operation, disruption response, succession and orderly transfer or wind-down of services and holdings." .

trsp:att.7495ADA28B
    a skos:Concept ;
    skos:prefLabel "Public Continuity Plan" ;
    skos:definition "A documented plan defining objectives, responsibilities, actions and arrangements for continuity." .

trsp:att.0CF10C6CFB
    a skos:Concept ;
    skos:prefLabel "Community Engagement" ;
    skos:definition "Ongoing interaction with relevant communities to understand needs, communicate plans and incorporate stakeholder input into repository decisions." .

trsp:att.01D16EFB9B
    a skos:Concept ;
    skos:prefLabel "Managed Stakeholder Dependencies" ;
    skos:definition "A document detailing the management and nature of stakeholder dependencies - end user groupings, depositors, funders, service users and aggregators, including statements of intent in respect of partnership and stakeholder management and its improvement." .

trsp:att.04DC5770C9
    a skos:Concept ;
    skos:prefLabel "Documentation on Community Engagement" ;
    skos:definition "Documented information explaining community engagement and how it is implemented or applied." .

trsp:att.13368CB9AC
    a skos:Concept ;
    skos:prefLabel "Impact Assessment" ;
    skos:definition "Information on impact of repsoitory services on the designated community and stakeholders." .

trsp:att.139CD89A8A
    a skos:Concept ;
    skos:prefLabel "Community Engagement" ;
    skos:definition "Demonstrable longer-term funding and income sources. Structural income is adequate. Revenue is justifiable, the source is clearly defined, and revenue does not come from selling the data or metadata holdings. Recovering justifiable cost, for example for disseminating or storing large data sets, is acceptable." .

trsp:att.3E8808255F
    a skos:Concept ;
    skos:prefLabel "Business Model" ;
    skos:definition "The organisational and financial model by which a service creates and sustains value, including its users, activities, resources, costs and sources of income." .

trsp:att.7CBE776C7A
    a skos:Concept ;
    skos:prefLabel "Business Model Type" ;
    skos:definition "A repository or research-infrastructure characteristic describing business model type in the context of business model." .

trsp:att.1EB263B2CE
    a skos:Concept ;
    skos:prefLabel "Revenue" ;
    skos:definition "Income received or expected to support the operation and development of a repository or service." .

trsp:att.410BA123B3
    a skos:Concept ;
    skos:prefLabel "Justifiable Cost" ;
    skos:definition "A financial measure or category representing justifiable cost associated with operating or sustaining the repository or service." .

trsp:att.2758AC32B8
    a skos:Concept ;
    skos:prefLabel "Justification of Income" ;
    skos:definition "A repository or research-infrastructure characteristic describing justification of income in the context of justifiable cost." .

trsp:att.0E0C905D2A
    a skos:Concept ;
    skos:prefLabel "Data is free" ;
    skos:definition "Identified primarily as a requirement for public infrastructure services by POSI, this criterion ensures that the data gathered by services is available without cost to the community, and serves as insurance should the service no longer be available." .

trsp:att.7660700650
    a skos:Concept ;
    skos:prefLabel "Compensation Rule" ;
    skos:definition "A repository or research-infrastructure characteristic describing compensation rule in the context of data is free." .

trsp:att.678439CD93
    a skos:Concept ;
    skos:prefLabel "Source" ;
    skos:definition "The origin, provider or funding source associated with the relevant resource, information or revenue." .

trsp:att.6EF77F35F8
    a skos:Concept ;
    skos:prefLabel "Revenue Type" ;
    skos:definition "A repository or research-infrastructure characteristic describing revenue type in the context of source." .

trsp:att.076A4C2950
    a skos:Concept ;
    skos:prefLabel "Revenue Source" ;
    skos:definition "A repository or research-infrastructure characteristic describing revenue source in the context of source." .

trsp:att.5CF6AB3B6E
    a skos:Concept ;
    skos:prefLabel "Adequacy of Structural Income" ;
    skos:definition "A repository or research-infrastructure characteristic describing adequacy of structural income in the context of financial sustainability." .

trsp:att.6F306E2CEA
    a skos:Concept ;
    skos:prefLabel "Publicly Available Accounts" ;
    skos:definition "A repository or research-infrastructure characteristic describing publicly available accounts in the context of adequacy of structural income." .

trsp:att.6EDF9A999F
    a skos:Concept ;
    skos:prefLabel "Defined and predictable funding regime" ;
    skos:definition "A repository or research-infrastructure characteristic describing defined and predictable funding regime in the context of adequacy of structural income." .

trsp:att.52A2A122AF
    a skos:Concept ;
    skos:prefLabel "Base operations structurally funded" ;
    skos:definition "A repository or research-infrastructure characteristic describing base operations structurally funded in the context of adequacy of structural income." .

trsp:att.269758D5A0
    a skos:Concept ;
    skos:prefLabel "R&D is Possible" ;
    skos:definition "Structural income makes provision for some R&D activity, and continuous improvement and baseline innovation is not dependent on ad-hoc income." .

trsp:att.4C2B1EA7BC
    a skos:Concept ;
    skos:prefLabel "Funding Details" ;
    skos:definition "A repository or research-infrastructure characteristic describing funding details in the context of adequacy of structural income." .

trsp:att.58915AD64B
    a skos:Concept ;
    skos:prefLabel "Funder List" ;
    skos:definition "A repository or research-infrastructure characteristic describing funder list in the context of funding details." .

trsp:att.00912FBE63
    a skos:Concept ;
    skos:prefLabel "Funder Name" ;
    skos:definition "Name of the funder funding the repository" .

trsp:att.07370ACB06
    a skos:Concept ;
    skos:prefLabel "Funder IRI" ;
    skos:definition "Funder Identifier" .

trsp:att.025E0B27C7
    a skos:Concept ;
    skos:prefLabel "Grant Amount" ;
    skos:definition "Value of the grant" .

trsp:att.2A1E8CB3A2
    a skos:Concept ;
    skos:prefLabel "Grant List" ;
    skos:definition "A repository or research-infrastructure characteristic describing grant list in the context of funding details." .

trsp:att.75B98BCB19
    a skos:Concept ;
    skos:prefLabel "Grant Name" ;
    skos:definition "Name of the fund" .

trsp:att.41DE70E553
    a skos:Concept ;
    skos:prefLabel "Grant IRI" ;
    skos:definition "Grant identifier" .

trsp:att.7DA1B3367B
    a skos:Concept ;
    skos:prefLabel "Technical Sustainability" ;
    skos:definition "Open availability of the technical means to reestablish the service elsewhere" .

trsp:att.79D95E290A
    a skos:Concept ;
    skos:prefLabel "Data Continuity" ;
    skos:definition "The ability to preserve access to and stewardship of data through disruptions, organisational change, service termination or transfer." .

trsp:att.5CB2FB5B4C
    a skos:Concept ;
    skos:prefLabel "Content is available free" ;
    skos:definition "A repository or research-infrastructure characteristic describing content is available free in the context of data continuity." .

trsp:att.608B9C73BB
    a skos:Concept ;
    skos:prefLabel "Open Data" ;
    skos:definition "Data made available for access and reuse under conditions that permit broad use, typically using an open licence and machine-accessible formats." .

trsp:att.3AD2ECA374
    a skos:Concept ;
    skos:prefLabel "Data is Available" ;
    skos:definition "An indicator that data is is publicly or otherwise appropriately available to intended users or assessors." .

trsp:att.4B417E2D31
    a skos:Concept ;
    skos:prefLabel "Open Source" ;
    skos:definition "Software for which source code is made available under a licence permitting inspection, use, modification and redistribution." .

trsp:att.7BCEAFB957
    a skos:Concept ;
    skos:prefLabel "No Patents on Source Code" ;
    skos:definition "A repository or research-infrastructure characteristic describing no patents on source code in the context of open source." .

trsp:att.792636C88D
    a skos:Concept ;
    skos:prefLabel "Source code is open or available on closure" ;
    skos:definition "Documentation on source code repositories in use for major repository software and services." .

trsp:att.04F0DB0243
    a skos:Concept ;
    skos:prefLabel "Planning" ;
    skos:definition "A documented plan defining objectives, responsibilities, actions and arrangements for planning." .

trsp:att.3609108196
    a skos:Concept ;

trsp:att.5152A52E1A
    a skos:Concept ;
    skos:prefLabel "Ensure Physical Objects have a Digital Representation" ;
    skos:definition "A repository or research-infrastructure characteristic describing ensure physical objects have a digital representation in the context of digital representation of physical objects." .

trsp:att.40296310DD
    a skos:Concept ;
    skos:prefLabel "Stewardship" ;
    skos:definition "The active, accountable care and management of data, metadata and related digital objects throughout their managed lifecycle." .

trsp:att.00C02C55DC
    a skos:Concept ;
    skos:prefLabel "Quality Control - Deposit Documentation" ;
    skos:definition "Ensuring that deposit documentation is adequate, meets well-defined quality standards or guidelines, and is technically sound (schema validation, file formats, ...)" .

trsp:att.4A98F89201
    a skos:Concept ;

    skos:definition "A documented plan defining objectives, responsibilities, actions and arrangements for risk." .

trsp:att.11E8C2B7D0
    a skos:Concept ;
    skos:prefLabel "Disaster Recovery Plan" ;
    skos:definition "A documented plan defining objectives, responsibilities, actions and arrangements for disaster recovery." .

trsp:att.14C87D5FC0
    a skos:Concept ;
    skos:prefLabel "Long-Term Preservation Plan" ;
    skos:definition "A documented plan defining objectives, responsibilities, actions and arrangements for long-term preservation." .

trsp:att.34A4F04633
    a skos:Concept ;
    skos:prefLabel "Resource Management Plan" ;
    skos:definition "Proper management of and planning for human resources and relevant expertise, financial and technology resources, and energy. Includes information about the organisational structure, skills, and skills development/ risks." .

trsp:att.36E657FC7B
    a skos:Concept ;
    skos:prefLabel "Repository or Collections Data Management Plan" ;
    skos:definition "Data Management Planning-related considerations applicable to the repository, its catalogues, and/ or collections." .

trsp:att.375960B05E
    a skos:Concept ;
    skos:prefLabel "Infrastructure Links" ;
    skos:definition "A repository or research-infrastructure characteristic describing infrastructure links in the context of sustainability." .

trsp:att.0341AA63B1
    a skos:Concept ;
    skos:prefLabel "Research Infrastructures Served" ;
    skos:definition "A discovery capability enabling users or machines to locate resources using research infrastructures served mechanisms." .

trsp:att.70BFED1AC3
    a skos:Concept ;
    skos:prefLabel "Portal Inclusion" ;
    skos:definition "A repository or research-infrastructure characteristic describing portal inclusion in the context of infrastructure links." .

trsp:att.394BC515E7
    a skos:Concept ;
    skos:prefLabel "EOSC Node Service" ;
    skos:definition "A repository or infrastructure capability concerning eosc node service, provided to users, systems or partner organisations." .

trsp:att.00BAFE4B4E
    a skos:Concept ;
    skos:prefLabel "Registered in EOSC Marketplace" ;
    skos:definition "A repository or research-infrastructure characteristic describing registered in eosc marketplace in the context of infrastructure links." .

trsp:att.241E6C58DF
    a skos:Concept ;
    skos:prefLabel "Network Membership" ;
    skos:definition "A repository or research-infrastructure characteristic describing network membership in the context of infrastructure links." .

trsp:att.65A95F223F
    a skos:Concept ;
    skos:prefLabel "Responsibility" ;
    skos:definition "The obligation to ensure that repository holdings and services are managed reliably, lawfully and in accordance with stated commitments." .

trsp:att.4A4B5A22FE
    a skos:Concept ;
    skos:prefLabel "Schema" ;
    skos:definition "Establishing appropriate metadata schema, as well as assisting to identify applicable file formats and schema" .

trsp:att.365F68CB18
